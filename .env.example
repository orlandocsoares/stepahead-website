# ============================================================
# Desenvolvimento local — copia para .env.local
# ============================================================
DATABASE_URL=postgres://sabermais:sabermais@localhost:5432/sabermais
NEXT_PUBLIC_APP_URL=http://localhost:9002
SESSION_SECRET=local-dev-secret-change-me

# ============================================================
# Produção (VPS) — copia para .env.production na VPS
# NUNCA faças commit dos valores reais
# ============================================================
# POSTGRES_DB=sabermais
# POSTGRES_USER=sabermais
# POSTGRES_PASSWORD=<gera com: openssl rand -hex 32>
# DATABASE_URL=postgres://sabermais:<PASSWORD>@db:5432/sabermais
# NEXT_PUBLIC_APP_URL=https://teu-dominio.edu.ao
# SESSION_SECRET=<gera com: openssl rand -hex 64>
# NODE_ENV=production
